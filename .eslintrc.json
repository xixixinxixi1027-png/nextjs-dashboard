{
  "extends": [
    "next/core-web-vitals",
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"  // 添加 TS 推荐规则
  ],
  "parser": "@typescript-eslint/parser",  // 使用 TS 解析器
  "plugins": ["@typescript-eslint"],  // 启用 TS 插件
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": "./tsconfig.json"  // 关联 TS 配置文件
  },
  "rules": {
    "no-undef": "off",
    "react/react-in-jsx-scope": "off",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]  // TS 未使用变量规则（忽略下划线开头的变量）
  },
  "settings": {
    "react": { "version": "detect" }
  }
}